# Brand (env-driven; domain purchase can happen later)
BRAND_NAME=TadaDing
PUBLIC_DOMAIN=localhost
SOCIAL_HANDLE=playtadading
TAGLINE='Your daily tiny win.'

# Origins (host ports chosen to avoid common local collisions)
WEB_ORIGIN=http://localhost:3100
API_ORIGIN=http://localhost:3101
NEXT_PUBLIC_API_ORIGIN=http://localhost:3101
WORKER_ORIGIN=http://localhost:3102

# Data (Compose maps host 5433->5432 and 6380->6379)
DATABASE_URL=postgres://tadading:tadading@localhost:5433/tadading
REDIS_URL=redis://localhost:6380

# Services
NODE_ENV=development
SERVICE_NAME=api
PORT=3101

# Secrets (override in production)
PUZZLE_SEED_SECRET=dev-puzzle-seed-secret-change-me
GUEST_HMAC_SECRET=dev-guest-hmac-secret-change-me
